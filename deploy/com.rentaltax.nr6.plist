<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd User Agent: com.rentaltax.nr6
  Fires November 1 at 09:00.

  Runs the NR6 election pipeline for the UPCOMING year:
    → Emails both owners asking for estimated {next_year} income/expenses
    → Waits up to 72 h for reply
    → Fills NR6 × 2 (election forms for next year)
    → Emails completed NR6 PDFs to both owners

  The NR6 must reach CRA before January 1 of the year being elected.
  Filing in November gives ~8 weeks for CRA to approve before January rent.

  Install:
    cp deploy/com.rentaltax.nr6.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.rentaltax.nr6.plist
-->
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.rentaltax.nr6</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
    <string>/Users/parisa/Desktop/python_codes/rental_tax_automation/main.py</string>
    <string>--renew-election</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/parisa/Desktop/python_codes/rental_tax_automation</string>

  <!-- November 1 at 09:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Month</key>   <integer>11</integer>
    <key>Day</key>     <integer>1</integer>
    <key>Hour</key>    <integer>9</integer>
    <key>Minute</key>  <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>  <false/>
  <key>KeepAlive</key>  <false/>

  <key>StandardOutPath</key>
  <string>/Users/parisa/Library/Logs/rentaltax/nr6.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/parisa/Library/Logs/rentaltax/nr6-error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>  <string>/Users/parisa</string>
    <key>PATH</key>  <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

</dict>
</plist>
